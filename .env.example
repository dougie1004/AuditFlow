# [AuditFlow] Environment Configuration Template
# DO NOT include real keys in this file. 
# Copy this to .env.development or .env.production and fill in the values.

# --- AI Core ---
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL_PRO=gemini-2.0-flash
GEMINI_MODEL_FAST=gemini-2.0-flash

# --- Database ---
# Path relative to the executable or absolute path
DATABASE_PATH=audit_data_v4.db

# --- Features ---
ENABLE_MOCK_DATA=true
DEBUG_MODE=true
